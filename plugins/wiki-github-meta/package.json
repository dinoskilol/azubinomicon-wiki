{
  "name": "@azubinomicon/wiki-github-meta",
  "version": "0.1.0",
  "description": "Quartz GitHub metadata transformer and component for Azubinomicon wiki pages",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./dist/index.js",
    "./components": "./dist/components/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "sideEffects": false,
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "quartz": {
    "name": "wiki-github-meta",
    "displayName": "Wiki GitHub Meta",
    "category": [
      "transformer",
      "component"
    ],
    "version": "0.1.0",
    "quartzVersion": ">=5.0.0",
    "defaultOrder": 12,
    "defaultEnabled": true,
    "components": {
      "WikiGitHubMeta": {
        "name": "WikiGitHubMeta",
        "displayName": "Wiki GitHub Meta",
        "description": "Shows edit, history, last commit, and contributor metadata for wiki pages",
        "version": "0.1.0",
        "defaultPosition": "beforeBody",
        "defaultPriority": 25
      }
    }
  }
}
